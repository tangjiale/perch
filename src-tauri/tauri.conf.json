{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "栖点",
  "version": "0.1.14",
  "identifier": "com.self.workbench",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "栖点 · Perch",
        "width": 1440,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/parser/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
